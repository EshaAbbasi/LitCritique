<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lit Critique</title>
  <!-- Notice the leading slash '/' before stylesheets -->
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playwrite+VN:wght@100..400&family=Source+Sans+3:wght@400;600;700&display=swap">
</head>
<body>

  <nav id="navbar">
    <!-- Left: Logo -->
    <a href="/" class="nav-logo">Lit Critique</a>

    <!-- Center Links -->
    <div class="nav-center">
      <a class="nav-link" href="/">Home</a>
      <a class="nav-link" href="/search">Search</a>
      <a class="nav-link" href="/add">Add</a>
      <a class="nav-link" href="/favourites">Favourites</a>
      <a class="nav-link" href="/about">About Us</a>
    </div>

    <!-- Right: Auth -->
    <div class="nav-right">
      <% if (user) { %>
        <a class="nav-link" href="/auth/sign-out">Sign Out</a>
      <% } else { %>
        <a class="nav-link" href="/auth/sign-in">Sign In</a>
        <a class="nav-link" href="/auth/sign-up">Sign Up</a>
      <% } %>
    </div>
  </nav>

 

</body>
</html>