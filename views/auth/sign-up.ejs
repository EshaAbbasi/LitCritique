<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up - Lit Critique</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playwrite+VN:wght@400&family=Source+Sans+3:wght@400;600;700&display=swap" />
</head>
<body class="auth-body">

  <div class="split-card">
    <!-- Left Column: Form Section -->
    <div class="split-left">
      <div class="brand-logo">Lit Critique</div>

      <div class="welcome-header">
        <h1>Create Account</h1>
       
      </div>

      <form action="/auth/sign-up" method="POST" class="split-form">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" placeholder="Choose a username" required />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Create a password" required />
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required />
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-secondary">Register</button>
          <a href="/auth/sign-in" class="btn btn-primary">Sign In</a>
        </div>
      </form>

      
    </div>

    <!-- Right Column: Image -->
    <div class="split-right"></div>
  </div>

</body>
</html>