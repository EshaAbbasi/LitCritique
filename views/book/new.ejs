<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Book - Lit Critique</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="/stylesheets/partials.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playwrite+VN:wght@400&family=Source+Sans+3:wght@400;600;700&display=swap" />
</head>
<body class="form-page-body">
  <%- include('../partials/_navbar.ejs') %>

  <div class="form-page">
    <div class="form-card">
      <div class="brand-logo">Lit Critique</div>

      <div class="welcome-header">
        <h1>Add a Book</h1>
        <p>Share what you're reading.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-error" style="color:#da5151; margin-bottom: 16px;"><%= error %></p>
      <% } %>

      <form action="/books" method="POST" enctype="multipart/form-data" class="form-grid">

        <div class="form-group">
          <label for="title">Title</label>
          <input
            type="text"
            id="title"
            name="title"
            placeholder="Enter book title"
            value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="author">Author</label>
          <input
            type="text"
            id="author"
            name="author"
            placeholder="Enter author name"
            value="<%= typeof formData !== 'undefined' && formData.author ? formData.author : '' %>"
          />
        </div>

        <div class="form-group">
          <label for="genre">Genre</label>
          <select id="genre" name="genre">
            <% ["Fiction","Non-Fiction","Fantasy","Sci-Fi","Mystery","Thriller","Romance","Historical Fiction","Horror","Biography","Memoir","Self-Help","Graphic Novel","Manga"].forEach(g => { %>
              <option value="<%= g %>" <%= (typeof formData !== 'undefined' && formData.genre === g) ? 'selected' : '' %>><%= g %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="wanttoread" <%= (typeof formData !== 'undefined' && formData.status === 'wanttoread') ? 'selected' : '' %>>Want to Read</option>
            <option value="reading" <%= (typeof formData !== 'undefined' && formData.status === 'reading') ? 'selected' : '' %>>Reading</option>
            <option value="finished" <%= (typeof formData !== 'undefined' && formData.status === 'finished') ? 'selected' : '' %>>Finished</option>
          </select>
        </div>

        <div class="form-group">
          <label for="rating">Rating (1-5)</label>
          <input
            type="number"
            name="rating"
            id="rating"
            min="1"
            max="5"
            value="<%= typeof formData !== 'undefined' && formData.rating ? formData.rating : '' %>"
          />
        </div>

        <div class="form-group">
          <label for="coverImage">Cover Image</label>
          <input type="file" id="coverImage" name="coverImage" accept="image/*" />
        </div>
  <div class="form-group form-group-full">
          <label for="reviewtext">Review</label>
          <input type="text" name="reviewtext" id="reviewtext"/>
        </div>
        <div class="form-actions form-group-full">
          <button type="submit" class="btn btn-primary">Add Book</button>
          <a href="/books" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>

</body>
</html>