<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit <%= book.title %> - Lit Critique</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="/stylesheets/partials.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playwrite+VN:wght@400&family=Source+Sans+3:wght@400;600;700&display=swap" />
</head>
<body class="form-page-body">
  <%- include('../partials/_navbar.ejs') %>

  <div class="form-page">
    <div class="form-card">
      <div class="brand-logo">Lit Critique</div>

      <div class="welcome-header">
        <h1>Edit Book</h1>
        <p>Update the details for this book.</p>
      </div>

      <form action="/books/<%= book._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="form-grid">

        <div class="form-group">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" value="<%= book.title %>" required />
        </div>

        <div class="form-group">
          <label for="author">Author</label>
          <input type="text" id="author" name="author" value="<%= book.author %>" />
        </div>

        <div class="form-group">
          <label for="genre">Genre</label>
          <select id="genre" name="genre">
            <option value="">-- Select genre --</option>
            <% ["Fiction","Non-Fiction","Fantasy","Sci-Fi","Mystery","Thriller","Romance","Historical Fiction","Horror","Biography","Memoir","Self-Help","Graphic Novel","Manga"].forEach(g => { %>
            <option value="<%= g %>" <%= book.genre === g ? 'selected' : '' %>><%= g %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="wanttoread" <%= book.status === 'wanttoread' ? 'selected' : '' %>>Want to Read</option>
            <option value="reading" <%= book.status === 'reading' ? 'selected' : '' %>>Reading</option>
            <option value="finished" <%= book.status === 'finished' ? 'selected' : '' %>>Finished</option>
          </select>
        </div>

        <div class="form-group">
          <label for="rating">Rating (1-5)</label>
          <input type="number" name="rating" id="rating" min="1" max="5" value="<%= book.rating %>" />
        </div>

        <div class="form-group">
          <label for="coverImage">Cover Image</label>
          <input type="file" id="coverImage" name="coverImage" accept="image/*" />
          <% if (book.coverImage) { %>
          <span class="current-file-note">Leave blank to keep current image</span>
          <% } %>
        </div>

        <div class="form-group form-group-full">
          <label for="reviewtext">Review</label>
          <input type="text" name="reviewtext" id="reviewtext" value="<%= book.reviewtext %>" placeholder="Your thoughts on the book" />
        </div>

        <div class="form-actions form-group-full">
          <button type="submit" class="btn btn-primary">Update Book</button>
          <a href="/books/<%= book._id %>" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>