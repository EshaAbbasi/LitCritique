<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- views/book/show.ejs -->
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css">

    <title><%= book.title %></title>
  </head>

  <body>
    <%- include('../partials/_navbar.ejs') %>

    <div class="show-page">
      <div class="show-card">

        <!-- LEFT: all the details -->
        <div class="show-info">
          <% const isFav = book.favoritedBy && currentUser && book.favoritedBy.some(id => id.toString() === currentUser._id.toString()); %>
          <div class="show-meta">
            <% if (book.genre) { %>
            <span class="meta-pill"><%= book.genre %></span>
            <% } %>
            <% if (book.status) { %>
            <span class="meta-pill meta-status"><%= book.status %></span>
            <% } %>
            <form action="/books/<%= book._id %>/favorite?_method=PUT" method="POST" class="fav-form-inline">
              <button type="submit" class="heart-icon-btn <%= isFav ? 'is-fav' : '' %>" aria-label="Toggle favorite">
                <%= isFav ? '♥' : '♡' %>
              </button>
            </form>
          </div>

          <p class="show-owner">Posted by <%= book.user ? book.user.username : 'Unknown' %></p>

          <% if (book.rating) { %>
          <div class="book-rating show-rating">
            <% for (let i = 1; i <= 5; i++) { %>
            <span class="star <%= i <= book.rating ? 'filled' : '' %>">★</span>
            <% } %>
            <span class="rating-number"><%= book.rating %>/5</span>
          </div>
          <% } %>

          <% if (book.reviewtext) { %>
          <div class="show-review">
            <h2>Review</h2>
            <p><%= book.reviewtext %></p>
          </div>
          <% } %>

          <% if (book.user && currentUser && book.user._id.toString() === currentUser._id.toString()) { %>
          <div class="show-actions">
            <a href="/books/<%= book._id %>/edit" class="btn btn-primary">Edit Book</a>
            <form action="/books/<%= book._id %>?_method=DELETE" method="POST" class="inline-form">
              <button type="submit" class="btn btn-secondary">Delete Book</button>
            </form>
          </div>
          <% } %>
        </div>

        <!-- RIGHT: cover image, then title/author below it -->
        <div class="show-cover-col">
          <% if (book.coverImage) { %>
          <img src="<%= book.coverImage %>" alt="<%= book.title %> cover" class="show-cover" />
          <% } else { %>
          <div class="show-cover show-cover-placeholder">No Cover</div>
          <% } %>

          <h1 class="show-title"><%= book.title %></h1>
          <p class="show-author">by <%= book.author %></p>
        </div>

      </div>

      <div class="show-notes-container">
        <div class="notes-header">
          <h2>Notes / Reviews</h2>
          <button type="button" id="toggle-note-form-btn" class="btn btn-primary btn-sm">+ Add Note</button>
        </div>

        <form
          action="/books/<%= book._id %>/notes"
          method="POST"
          id="add-note-form"
          class="note-form"
          style="display: none;"
        >
          <div class="note-form-field note-form-field-text">
            <label for="text">Note</label>
            <textarea name="text" id="text" required></textarea>
          </div>

          <div class="note-form-field note-form-field-page">
            <label for="page">Page (optional)</label>
            <input type="number" name="page" id="page" />
          </div>

          <button type="submit" class="btn btn-primary btn-sm">Save Note</button>
        </form>

        <% if (book.notes && book.notes.length) { %>
        <ul class="notes-list">
          <% book.notes.forEach(note => { %>
          <% const noteOwnerId = note.user && note.user._id ? note.user._id.toString() : (note.user ? note.user.toString() : ''); %>
          <% const isNoteOwner = currentUser && noteOwnerId === currentUser._id.toString(); %>
          <li class="note-card">
            <p class="note-author">
              <strong><%= note.user && note.user.username ? note.user.username : 'Unknown' %></strong>
            </p>

            <!-- Read-only view -->
            <div class="note-view" id="note-view-<%= note._id %>">
              <p class="note-text"><%= note.text %></p>
              <div class="note-footer">
                <% if (note.page) { %>
                <span class="note-page">Page <%= note.page %></span>
                <% } %>
                <small class="note-date"><%= note.createdAt.toLocaleDateString() %></small>

                <% if (isNoteOwner) { %>
                <button
                  type="button"
                  class="note-edit-btn"
                  aria-label="Edit note"
                  onclick="toggleNoteEdit('<%= note._id %>')"
                >✏️</button>

                <form
                  action="/books/<%= book._id %>/notes/<%= note._id %>?_method=DELETE"
                  method="POST"
                  class="inline-form"
                >
                  <button type="submit" class="note-delete-btn" aria-label="Delete note">🗑</button>
                </form>
                <% } %>
              </div>
            </div>

            <!-- Edit form, hidden by default, owner-only -->
            <% if (isNoteOwner) { %>
            <form
              action="/books/<%= book._id %>/notes/<%= note._id %>?_method=PUT"
              method="POST"
              class="note-form note-edit-form"
              id="note-edit-form-<%= note._id %>"
              style="display: none;"
            >
              <div class="note-form-field note-form-field-text">
                <label for="text-<%= note._id %>">Note</label>
                <textarea name="text" id="text-<%= note._id %>" required><%= note.text %></textarea>
              </div>

              <div class="note-form-field note-form-field-page">
                <label for="page-<%= note._id %>">Page (optional)</label>
                <input type="number" name="page" id="page-<%= note._id %>" value="<%= note.page || '' %>" />
              </div>

              <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
              <button type="button" class="btn btn-secondary btn-sm" onclick="toggleNoteEdit('<%= note._id %>')">Cancel</button>
            </form>
            <% } %>
          </li>
          <% }) %>
        </ul>
        <% } else { %>
        <p class="no-notes">No notes yet.</p>
        <% } %>
      </div>
    </div>

    <script>
      const toggleBtn = document.getElementById('toggle-note-form-btn');
      const noteForm = document.getElementById('add-note-form');

      toggleBtn.addEventListener('click', () => {
        const isHidden = noteForm.style.display === 'none';
        noteForm.style.display = isHidden ? 'block' : 'none';
        toggleBtn.textContent = isHidden ? 'Cancel' : '+ Add Note';
      });

      function toggleNoteEdit(noteId) {
        const viewEl = document.getElementById(`note-view-${noteId}`);
        const editEl = document.getElementById(`note-edit-form-${noteId}`);
        const isEditing = editEl.style.display !== 'none';

        editEl.style.display = isEditing ? 'none' : 'block';
        viewEl.style.display = isEditing ? 'block' : 'none';
      }
    </script>
  </body>
</html>